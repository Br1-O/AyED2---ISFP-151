<mxfile host="65bd71144e">
    <diagram id="K7TSUPLXbhs4pdp-LI1U" name="Page-1">
        <mxGraphModel dx="1517" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% ---------------------------------------------------------\n    %% CAPA DE DOMINIO (Domain Layer)\n    %% ---------------------------------------------------------\n    namespace Domain_Layer {\n        class Article {\n            -int id\n            -string name\n            -double unitPrice\n            -int stock\n            +Article(id: int, name: string, unitPrice: double, stock: int)\n            +getId() int\n            +getName() string\n            +getUnitPrice() double\n            +getStock() int\n        }\n\n        class Supplier {\n            -int id\n            -string name\n            -string cuit\n            -string email\n            +Supplier(id: int, name: string, cuit: string, email: string)\n            +getId() int\n            +getName() string\n            +getCuit() string\n            +getEmail() string\n            +setId(id: int) void\n            +setName(name: string) void\n            +setCuit(cuit: string) void\n            +setEmail(email: string) void\n        }\n\n        class OrderDetail {\n            -shared_ptr~Article~ article\n            -int quantity\n            +OrderDetail(article: shared_ptr~Article~, quantity: int)\n            +calculateSubtotal() double\n            +getArticle() shared_ptr~Article~\n            +getQuantity() int\n        }\n\n        class Order {\n            -int id\n            -Supplier supplier\n            -vector~OrderDetail~ details\n            +Order(id: int, supplier: Supplier)\n            +getId() int\n            +getSupplier() Supplier\n            +getDetails() vector~OrderDetail~\n            +setId(id: int) void\n            +addDetail(article: shared_ptr~Article~, quantity: int) void\n        }\n\n        class ISupplierRepository {\n            &lt;&lt;interface&gt;&gt;\n            +~ISupplierRepository()\n            +save(supplier: Supplier) Supplier\n            +findById(id: int) optional~Supplier~\n            +findAll() vector~Supplier~\n            +update(supplier: Supplier) void\n            +remove(id: int) void\n        }\n\n        class IArticleRepository {\n            &lt;&lt;interface&gt;&gt;\n            +~IArticleRepository()\n            +save(article: shared_ptr~Article~) void\n            +findById(id: int) optional~shared_ptr~Article~~\n            +findAll() vector~shared_ptr~Article~~\n        }\n\n        class IOrderRepository {\n            &lt;&lt;interface&gt;&gt;\n            +~IOrderRepository()\n            +save(order: Order) Order\n            +findAll() vector~Order~\n        }\n    }\n\n    %% ---------------------------------------------------------\n    %% CAPA DE APLICACIÓN (Application Layer)\n    %% ---------------------------------------------------------\n    namespace Application_Layer {\n        class SupplierService {\n            -shared_ptr~ISupplierRepository~ supplierRepo\n            +SupplierService(supplierRepo: shared_ptr~ISupplierRepository~)\n            +createSupplier(name: string, cuit: string, email: string) Supplier\n            +getAllSuppliers() vector~Supplier~\n            +getSupplierById(id: int) optional~Supplier~\n            +updateSupplier(supplier: Supplier) void\n            +deleteSupplier(id: int) void\n        }\n\n        class ArticleService {\n            -shared_ptr~IArticleRepository~ articleRepo\n            +ArticleService(articleRepo: shared_ptr~IArticleRepository~)\n            +registerArticle(id: int, name: string, price: double, stock: int) void\n            +getAllArticles() vector~shared_ptr~Article~~\n            +getArticleById(id: int) optional~shared_ptr~Article~~\n        }\n\n        class OrderService {\n            -shared_ptr~IOrderRepository~ orderRepo\n            -shared_ptr~ISupplierRepository~ supplierRepo\n            -shared_ptr~IArticleRepository~ articleRepo\n            +OrderService(orderRepo: shared_ptr~IOrderRepository~, supplierRepo: shared_ptr~ISupplierRepository~, articleRepo: shared_ptr~IArticleRepository~)\n            +createOrder(supplierId: int, items: vector~pair_int_int~) Order\n            +getAllOrders() vector~Order~\n        }\n    }\n\n    %% ---------------------------------------------------------\n    %% CAPA DE INFRAESTRUCTURA (Infrastructure Layer)\n    %% ---------------------------------------------------------\n    namespace Infrastructure_Layer {\n        class InMemorySupplierRepository {\n            -vector~Supplier~ suppliers\n            -int nextId\n            -InMemorySupplierRepository()\n            +getInstance()$ InMemorySupplierRepository&amp;\n            +save(supplier: Supplier) Supplier\n            +findById(id: int) optional~Supplier~\n            +findAll() vector~Supplier~\n            +update(supplier: Supplier) void\n            +remove(id: int) void\n        }\n\n        class InMemoryArticleRepository {\n            -vector~shared_ptr~Article~~ articles\n            -InMemoryArticleRepository()\n            +getInstance()$ InMemoryArticleRepository&amp;\n            +save(article: shared_ptr~Article~) void\n            +findById(id: int) optional~shared_ptr~Article~~\n            +findAll() vector~shared_ptr~Article~~\n        }\n\n        class InMemoryOrderRepository {\n            -vector~Order~ orders\n            -int nextId\n            -InMemoryOrderRepository()\n            +getInstance()$ InMemoryOrderRepository&amp;\n            +save(order: Order) Order\n            +findAll() vector~Order~\n        }\n\n        class ConsoleMenu {\n            -shared_ptr~SupplierService~ supplierService\n            -shared_ptr~ArticleService~ articleService\n            -shared_ptr~OrderService~ orderService\n            +ConsoleMenu(supplierService: shared_ptr~SupplierService~, articleService: shared_ptr~ArticleService~, orderService: shared_ptr~OrderService~)\n            +start() void\n        }\n\n        class AppConfig {\n            +createConsoleMenu()$ shared_ptr~ConsoleMenu~\n        }\n    }\n\n    %% ---------------------------------------------------------\n    %% RELACIONES\n    %% ---------------------------------------------------------\n    %% Dominio Interno\n    Order --&gt; Supplier : asignado a\n    Order *-- OrderDetail : contiene\n    OrderDetail --&gt; Article : referencia\n\n    %% Aplicación hacia Dominio\n    SupplierService --&gt; ISupplierRepository : usa\n    ArticleService --&gt; IArticleRepository : usa\n    OrderService --&gt; IOrderRepository : usa\n    OrderService --&gt; ISupplierRepository : usa\n    OrderService --&gt; IArticleRepository : usa\n\n    %% Infraestructura implementando interfaces de Dominio\n    ISupplierRepository &lt;|.. InMemorySupplierRepository : implementa\n    IArticleRepository &lt;|.. InMemoryArticleRepository : implementa\n    IOrderRepository &lt;|.. InMemoryOrderRepository : implementa\n\n    %% Infraestructura hacia Aplicación / Configuración\n    ConsoleMenu --&gt; SupplierService : usa\n    ConsoleMenu --&gt; ArticleService : usa\n    ConsoleMenu --&gt; OrderService : usa\n    AppConfig --&gt; ConsoleMenu : instancia&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="xaqEr2LQVHnRcs5_clzv-1">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
